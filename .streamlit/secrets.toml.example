# Template for the dashboard's secrets when deployed on Streamlit Community
# Cloud (Settings -> Secrets on your app, or during initial deploy).
#
# DO NOT commit a real `.streamlit/secrets.toml` -- it's gitignored on
# purpose. Copy this file's contents into the Streamlit Cloud "Secrets" box
# and fill in real values there instead.
#
# These are read the same way as any other config in this project (see
# src/fast_track/config.py) -- app.py bridges Streamlit's secrets manager
# into regular environment variables at startup, so nothing else needs to
# change between running locally, in GitHub Actions, or on Streamlit Cloud.

CREATORIQ_BASE_URL = "https://apis.creatoriq.com"
CREATORIQ_API_KEY = ""
CREATORIQ_CAMPAIGN_ID = ""

GIFT_ORDER_SHEET_ID = ""
GIFT_ORDER_WORKSHEET_NAME = "Gift Card Orders"

# Paste the full service-account JSON key contents as a single triple-quoted
# string (NOT as a nested TOML table) -- it's parsed as raw JSON text by
# gift_order_sheet.py, same as when this is set as a Cursor Cloud / GitHub
# Actions secret.
GOOGLE_SERVICE_ACCOUNT_JSON = '''
{
  "type": "service_account",
  "...": "..."
}
'''

# The dashboard is read-only against local state. Streamlit Cloud's
# filesystem is ephemeral and completely separate from wherever the
# scheduled weekly-cohort/daily-activity-sync jobs actually run (GitHub
# Actions) -- without the two settings below, the dashboard would just
# show "No gift awards recorded yet" forever. Set these so it pulls the
# latest `fast-track-db` artifact those workflows upload on every run
# (see .github/workflows/*.yml and src/fast_track/dashboard/db_sync.py):
GITHUB_REPO = "lpereira1-dot/Fast-Track-Creators"
# A GitHub Personal Access Token with `actions:read` access to this repo
# (fine-grained PAT: Repository permissions -> Actions -> Read-only).
GITHUB_TOKEN = ""

FAST_TRACK_DB_PATH = "data/fast_track.db"
