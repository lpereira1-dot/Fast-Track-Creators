# Copy to .env and fill in for local development.
# In GitHub Actions / Cursor Cloud, set these as Secrets instead of committing a .env file.

# --- CreatorIQ (ExchangeIQ) API ---------------------------------------------
# Request an API key from your CreatorIQ account rep or support@creatoriq.com.
CREATORIQ_BASE_URL=https://apis.creatoriq.com
CREATORIQ_API_KEY=
# Optional: scope "new creator" pulls to a specific Fast Track campaign/list.
CREATORIQ_CAMPAIGN_ID=
CREATORIQ_PUBLISHER_LIST_ID=
# Set to true to use fixtures/creatoriq/*.json instead of live API calls (demos, local dev, CI).
CREATORIQ_USE_FIXTURES=false

# --- Google Sheets (gift-card ordering sheet) -------------------------------
GIFT_ORDER_SHEET_ID=
GIFT_ORDER_WORKSHEET_NAME=Gift Card Orders
# Path to a Google service-account JSON key that has edit access to the sheet
# (share the sheet with the service account's client_email).
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Program rules -----------------------------------------------------------
ACTIVATION_WINDOW_DAYS=14
FIRST_POST_GIFT_USD=25
FIRST_SALE_GIFT_USD=25
RETENTION_WINDOW_DAYS=30
COHORT_WEEK_START_WEEKDAY=1

# --- Local storage -----------------------------------------------------------
FAST_TRACK_DB_PATH=data/fast_track.db
