# Copy to .env and fill in for local development.
# In GitHub Actions / Cursor Cloud, set these as Secrets instead of committing a .env file.

# --- CreatorIQ (ExchangeIQ) API ---------------------------------------------
# Request an API key from your CreatorIQ account rep or support@creatoriq.com.
CREATORIQ_BASE_URL=https://apis.creatoriq.com
CREATORIQ_API_KEY=
# Required: the CampaignId that Fast Track creators are added to (see
# README "Adapting to your CreatorIQ account"). This campaign's roster is
# the source of truth for who's in the program, when they joined, and
# whether they've posted -- without it, the weekly job pulls no creators.
CREATORIQ_CAMPAIGN_ID=
# Set to true to use fixtures/creatoriq/*.json instead of live API calls (demos, local dev, CI).
CREATORIQ_USE_FIXTURES=false

# --- Google Sheets (gift-card ordering sheet) -------------------------------
GIFT_ORDER_SHEET_ID=
GIFT_ORDER_WORKSHEET_NAME=Gift Card Orders
# A Google service-account key with edit access to the sheet (share the sheet
# with the service account's client_email). Set this to EITHER:
#   - a file path, e.g. GOOGLE_SERVICE_ACCOUNT_JSON=./service_account.json, or
#   - the full JSON key contents pasted directly (handy when this is set via
#     a secrets manager / CI / Cursor Cloud secret rather than a local file).
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Program rules -----------------------------------------------------------
ACTIVATION_WINDOW_DAYS=14
FIRST_POST_GIFT_USD=25
FIRST_SALE_GIFT_USD=25
RETENTION_WINDOW_DAYS=30
COHORT_WEEK_START_WEEKDAY=1

# --- Local storage -----------------------------------------------------------
FAST_TRACK_DB_PATH=data/fast_track.db
